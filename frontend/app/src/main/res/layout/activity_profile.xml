                    android:textColor="#022F77"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="#E2ECF8" />

                <!-- Lab Group -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Assigned Lab Group"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tvLabGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Group G01 (ICT 361)"
                    android:textColor="#022F77"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <!-- Sign Out Button -->
            <Button
                android:id="@+id/btnSignOut"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_pill_button_outline"
                app:backgroundTint="@null"
                android:text="@string/logout"
                android:textAllCaps="false"
                android:textColor="#E51937"
                android:textSize="14sp"
