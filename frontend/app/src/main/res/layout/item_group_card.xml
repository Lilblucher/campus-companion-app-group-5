<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/cc_card_bordered"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivGroupIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cc_iconchip_blue"
            android:padding="9dp"
            android:src="@drawable/ic_ms_workspaces"
            app:tint="@color/cc_accent_blue"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvGroupCodeBadge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="G01"
            android:textColor="@color/cc_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <TextView
            android:id="@+id/tvMemberCapacity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14/15"
            android:textColor="@color/cc_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="@color/cc_accent_blue"
        app:trackColor="@color/cc_light_blue"
        android:max="15"
        android:progress="14" />

    <TextView
        android:id="@+id/tvGroupDepartment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1 seat left"
        android:textColor="@color/cc_text_muted"
        android:textSize="12sp"
        android:fontFamily="@font/poppins" />

    <!-- Group action buttons for lecturer -->
    <LinearLayout
        android:id="@+id/layoutGroupActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp">

        <Button
            android:id="@+id/btnCardAddMember"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/cc_btn_outline"
            app:backgroundTint="@null"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="+ Add"
            android:textColor="@color/cc_navy"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins" />

        <Button
            android:id="@+id/btnCardRemoveMember"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/cc_btn_outline"
            app:backgroundTint="@null"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Remove"
            android:textColor="@color/cc_crimson"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins" />

        <Button
            android:id="@+id/btnCardExportExcel"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/cc_btn_navy"
            app:backgroundTint="@null"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:text="Export Excel"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins" />
    </LinearLayout>
</LinearLayout>
