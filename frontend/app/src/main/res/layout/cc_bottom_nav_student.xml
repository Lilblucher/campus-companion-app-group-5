<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cc_surface"
    android:elevation="12dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cc_divider_strong" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <LinearLayout android:id="@+id/navDashboard" style="@style/CcNavItem">
            <FrameLayout style="@style/CcNavPill">
                <ImageView style="@style/CcNavIcon" android:src="@drawable/nav_ic_home" android:contentDescription="@string/nav_dashboard" />
            </FrameLayout>
            <TextView style="@style/CcNavLabel" android:text="Home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navGroup" style="@style/CcNavItem">
            <FrameLayout style="@style/CcNavPill">
                <ImageView style="@style/CcNavIcon" android:src="@drawable/nav_ic_group" android:contentDescription="@string/nav_group" />
            </FrameLayout>
            <TextView style="@style/CcNavLabel" android:text="@string/nav_group" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navCourses" style="@style/CcNavItem">
            <FrameLayout style="@style/CcNavPill">
                <ImageView style="@style/CcNavIcon" android:src="@drawable/ic_ms_menu_book" android:contentDescription="@string/nav_courses" />
            </FrameLayout>
            <TextView style="@style/CcNavLabel" android:text="@string/nav_courses" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile" style="@style/CcNavItem">
            <FrameLayout style="@style/CcNavPill">
                <ImageView style="@style/CcNavIcon" android:src="@drawable/nav_ic_profile" android:contentDescription="@string/nav_profile" />
            </FrameLayout>
            <TextView style="@style/CcNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navSettings" style="@style/CcNavItem">
            <FrameLayout style="@style/CcNavPill">
                <ImageView style="@style/CcNavIcon" android:src="@drawable/nav_ic_settings" android:contentDescription="@string/nav_settings" />
            </FrameLayout>
            <TextView style="@style/CcNavLabel" android:text="@string/nav_settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
