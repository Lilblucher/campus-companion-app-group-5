<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".AccountsActivity">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Accounts &amp; Fees"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <ImageButton
            android:id="@+id/btnBell"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_ms_notifications"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Curved sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_curved_light_sheet">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- ===== Summary card ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="16dp">

                    <!-- Subtitle -->
                    <TextView
                        android:id="@+id/tvTuitionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2026 tuition - Computer Science Year 3"
                        android:textColor="@color/cc_text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                    <!-- Amount row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="bottom">

                        <TextView
                            android:id="@+id/tvAmountPaid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="K6,000"
                            android:textColor="@color/cc_navy"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvAmountTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="4dp"
                            android:text="paid of K12,000"
                            android:textColor="@color/cc_text_muted"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <!-- Progress bar -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:layout_marginTop="12dp">

                        <ProgressBar
                            android:id="@+id/progressTuition"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:max="100"
                            android:progress="50"
                            android:progressDrawable="@drawable/cc_progress_green" />

                        <!-- 50% marker -->
                        <View
                            android:id="@+id/marker50"
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:background="@color/cc_text_secondary" />
                    </FrameLayout>

                    <!-- Progress detail -->
                    <TextView
                        android:id="@+id/tvProgressDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="50% paid - 50% unlocks credentials - Balance K6,000"
                        android:textColor="@color/cc_text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                    <!-- Status banner -->
                    <LinearLayout
                        android:id="@+id/statusBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/cc_banner_success"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/statusIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_ms_check_circle"
                            app:tint="@color/cc_success"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="You have met the 50% threshold. Credentials unlocked."
                            android:textColor="@color/cc_success"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Payment history ===== -->
                <TextView
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="24dp"
                    android:text="Payment history" />

                <LinearLayout
                    android:id="@+id/paymentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- ===== Make a payment button ===== -->
                <Button
                    android:id="@+id/btnMakePayment"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/cc_btn_navy"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_ms_payments"
                    android:drawablePadding="10dp"
                    android:drawableTint="@android:color/white"
                    android:gravity="center"
                    android:text="Make a payment"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</FrameLayout>
