<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".LecturerDashboardActivity">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/avatarContainer"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tvAvatarInitials"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/cc_avatar_navy"
                    android:gravity="center"
                    android:text="DM"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <ImageView android:id="@+id/ivAvatar" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:contentDescription="@null" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Dr. Mulenga"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tvDepartment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lecturer_role"
                    android:textColor="@color/cc_on_navy_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnBell"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_ms_notifications"
                app:tint="@color/white"
                android:contentDescription="@string/nav_alerts" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/cc_search_pill"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_ms_search"
                app:tint="@color/cc_text_muted"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lecturer_search_hint"
                android:textColor="@color/cc_text_muted"
                android:textSize="14sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cc_sheet_top"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Stats row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout style="@style/CcStatCard" android:layout_marginEnd="5dp">
                        <TextView android:id="@+id/tvStatStudents" style="@style/CcStatNumber" android:textColor="@color/cc_navy" android:text="—" />
                        <TextView style="@style/CcStatLabel" android:text="Students" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/statUnassignedCard" style="@style/CcStatCard" android:layout_marginStart="5dp" android:layout_marginEnd="5dp">
                        <TextView android:id="@+id/tvStatUnassigned" style="@style/CcStatNumber" android:textColor="@color/cc_warning_strong" android:text="—" />
                        <TextView style="@style/CcStatLabel" android:text="Unassigned" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/statRequestsCard" style="@style/CcStatCard" android:layout_marginStart="5dp">
                        <TextView android:id="@+id/tvStatRequests" style="@style/CcStatNumber" android:textColor="@color/cc_crimson" android:text="—" />
                        <TextView style="@style/CcStatLabel" android:text="Requests" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/tileGenerateClaimCode" style="@style/CcTile" android:layout_marginEnd="6dp">
                        <ImageView style="@style/CcTileIcon" android:background="@drawable/cc_iconchip_blue" android:src="@drawable/ic_ms_key" app:tint="@color/cc_accent_blue" android:contentDescription="@null" />
                        <TextView style="@style/CcTileTitle" android:text="@string/generate_claim_code" />
                        <TextView style="@style/CcTileSub" android:text="Create student claim code" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tileMyCourses" style="@style/CcTile" android:layout_marginStart="6dp">
                        <ImageView style="@style/CcTileIcon" android:background="@drawable/cc_iconchip_blue" android:src="@drawable/ic_ms_menu_book" app:tint="@color/cc_navy" android:contentDescription="@null" />
                        <TextView style="@style/CcTileTitle" android:text="@string/my_courses" />
                        <TextView style="@style/CcTileSub" android:text="Teaching schedule" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/tileLabGroups" style="@style/CcTile" android:layout_marginEnd="6dp">
                        <ImageView style="@style/CcTileIcon" android:background="@drawable/cc_iconchip_green" android:src="@drawable/ic_ms_workspaces" app:tint="@color/cc_success" android:contentDescription="@null" />
                        <TextView style="@style/CcTileTitle" android:text="@string/lab_groups_tile" />
                        <TextView style="@style/CcTileSub" android:text="Manage G01–G04" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tilePostAnnouncement" style="@style/CcTile" android:layout_marginStart="6dp">
                        <ImageView style="@style/CcTileIcon" android:background="@drawable/cc_iconchip_amber" android:src="@drawable/ic_ms_campaign" app:tint="@color/cc_warning_strong" android:contentDescription="@null" />
                        <TextView style="@style/CcTileTitle" android:text="@string/post_announcement" />
                        <TextView style="@style/CcTileSub" android:text="Broadcast to students" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Upcoming lecture -->
                <TextView
                    android:id="@+id/tvUpcomingLectureHeader"
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/upcoming_lecture" />

                <LinearLayout
                    android:id="@+id/cardUpcomingLecture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="14dp">

                    <ImageView
                        android:id="@+id/ivLectureIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/cc_iconchip_navy"
                        android:padding="12dp"
                        android:src="@drawable/ic_ms_code"
                        app:tint="@color/white"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLectureTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="ICT 361 · Software Engineering"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvLectureTimeLocation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Wed 10:00 – 12:00 · Computer Lab 2"
                            android:textColor="@color/cc_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvLectureGroupInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Groups G01–G04"
                            android:textColor="@color/cc_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

                <!-- View student records -->
                <Button
                    android:id="@+id/btnViewRecords"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/cc_btn_navy"
                    app:backgroundTint="@null"
                    android:text="View student records"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:elevation="2dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <include
        layout="@layout/cc_bottom_nav_lecturer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
