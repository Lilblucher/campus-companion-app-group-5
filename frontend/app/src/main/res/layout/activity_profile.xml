<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".ProfileActivity">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/profile_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <ImageButton
            android:id="@+id/btnBell"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_ms_notifications"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Curved sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_curved_light_sheet">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- ===== Identity card ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/cc_avatar_crimson"
                        android:gravity="center"
                        android:text="CM"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Chileshe Mulenga"
                        android:textColor="@color/cc_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvProfileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Computer Science · Year 3"
                        android:textColor="@color/cc_text_muted"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins" />

                    <!-- Edit profile pill button -->
                    <LinearLayout
                        android:id="@+id/btnEditProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="20dp"
                        android:background="@drawable/cc_btn_outline_navy"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_ms_edit"
                            app:tint="@color/cc_navy"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/edit_profile"
                            android:textColor="@color/cc_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Personal Information ===== -->
                <TextView style="@style/CcSectionTitle" android:layout_marginTop="8dp" android:text="@string/personal_info" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="6dp">

                    <LinearLayout style="@style/CcInfoRow">
                        <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_mail" android:contentDescription="@null" />
                        <LinearLayout style="@style/CcSwitchText">
                            <TextView style="@style/CcInfoLabel" android:text="Email Address" />
                            <TextView android:id="@+id/tvEmail" style="@style/CcInfoValue" tools:text="210482910@mu.ac.zm" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/CcRowDivider" />

                    <LinearLayout style="@style/CcInfoRow">
                        <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_school" android:contentDescription="@null" />
                        <LinearLayout style="@style/CcSwitchText">
                            <TextView style="@style/CcInfoLabel" android:text="Programme &amp; Year" />
                            <TextView android:id="@+id/tvProgrammeYear" style="@style/CcInfoValue" tools:text="Computer Science · Year 3" />
                        </LinearLayout>
                    </LinearLayout>

                    <View style="@style/CcRowDivider" />

                    <LinearLayout style="@style/CcInfoRow">
                        <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_groups" android:contentDescription="@null" />
                        <LinearLayout style="@style/CcSwitchText">
                            <TextView style="@style/CcInfoLabel" android:text="Assigned Lab Group" />
                            <TextView android:id="@+id/tvLabGroup" style="@style/CcInfoValue" tools:text="G01 · Computer Lab 2" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Student credentials ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/CcSectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/student_credentials" />

                    <!-- Status chip -->
                    <LinearLayout
                        android:id="@+id/credentialChip"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/cc_banner_success">

                        <ImageView
                            android:id="@+id/ivCredentialChipIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_ms_lock_open"
                            app:tint="@color/cc_green_fg"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvCredentialChipLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/credentials_unlocked"
                            android:textColor="@color/cc_green_fg"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Credentials unlocked content -->
                <LinearLayout
                    android:id="@+id/credentialsUnlocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- Student ID card (navy) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/cc_card_hero"
                        android:padding="16dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvIdCardInitials"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/cc_avatar_light"
                            android:gravity="center"
                            android:text="CM"
                            android:textColor="@color/cc_navy"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MULUNGUSHI UNIVERSITY · STUDENT ID"
                                android:textColor="@color/cc_on_navy_muted"
                                android:textSize="10sp"
                                android:fontFamily="@font/poppins"
                                android:letterSpacing="0.05" />

                            <TextView
                                android:id="@+id/tvIdCardName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Chileshe Mulenga"
                                android:textColor="@android:color/white"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/poppins" />

                            <TextView
                                android:id="@+id/tvIdCardMeta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="210482910 · CS · Year 3 · Valid to Dec 2026"
                                android:textColor="@color/cc_on_navy_muted"
                                android:textSize="11sp"
                                android:fontFamily="@font/poppins" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Credential rows -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical"
                        android:background="@drawable/cc_card_bordered"
                        android:padding="6dp">

                        <LinearLayout style="@style/CcInfoRow">
                            <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_pin" android:contentDescription="@null" />
                            <LinearLayout style="@style/CcSwitchText">
                                <TextView style="@style/CcInfoLabel" android:text="@string/student_number" />
                                <TextView android:id="@+id/tvStudentNumber" style="@style/CcInfoValue" tools:text="210482910" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/CcRowDivider" />

                        <LinearLayout style="@style/CcInfoRow">
                            <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_confirmation_number" android:contentDescription="@null" />
                            <LinearLayout style="@style/CcSwitchText">
                                <TextView style="@style/CcInfoLabel" android:text="Exam Number" />
                                <TextView android:id="@+id/tvExamNumber" style="@style/CcInfoValue" tools:text="EX-2026-2910" />
                            </LinearLayout>
                        </LinearLayout>

                        <View style="@style/CcRowDivider" />

                        <LinearLayout style="@style/CcInfoRow">
                            <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_account_circle" android:contentDescription="@null" />
                            <LinearLayout style="@style/CcSwitchText">
                                <TextView style="@style/CcInfoLabel" android:text="Portal Username" />
                                <TextView android:id="@+id/tvPortalUsername" style="@style/CcInfoValue" tools:text="cm210482910" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Credentials locked content -->
                <LinearLayout
                    android:id="@+id/credentialsLocked"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="24dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_ms_lock"
                        app:tint="@color/cc_amber_fg"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/credentials_locked_info"
                        android:textColor="@color/cc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:id="@+id/tvLockedPct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="You've paid 30%..."
                        android:textColor="@color/cc_text_muted"
                        android:textSize="13sp"
                        android:textAlignment="center"
                        android:fontFamily="@font/poppins" />

                    <Button
                        android:id="@+id/btnViewFees"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:background="@drawable/cc_btn_outline_navy"
                        app:backgroundTint="@null"
                        android:text="@string/view_fees"
                        android:textAllCaps="false"
                        android:textColor="@color/cc_navy"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <!-- ===== Accounts & fees row ===== -->
                <LinearLayout
                    android:id="@+id/rowAccounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_ms_account_balance_wallet"
                        app:tint="@color/cc_navy"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/accounts_fees_row"
                        android:textColor="@color/cc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        app:tint="@color/cc_text_muted"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- ===== Sign out ===== -->
                <Button
                    android:id="@+id/btnSignOut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/cc_btn_outline_crimson"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_ms_logout"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/cc_crimson"
                    android:gravity="center"
                    android:text="@string/logout"
                    android:textAllCaps="false"
                    android:textColor="@color/cc_crimson"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Bottom nav -->
    <include
        layout="@layout/cc_bottom_nav_student"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
