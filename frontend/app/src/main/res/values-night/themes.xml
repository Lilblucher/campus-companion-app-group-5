<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CampusCompanionApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- The light theme hardcodes a white, dark-icon status bar for the
             (currently all-white app-bar) screens; in dark mode that reads as a
             stray white strip above a dark page, so swap to a dark bar with
             light icons instead. -->
        <item name="android:statusBarColor">@color/cc_page_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>