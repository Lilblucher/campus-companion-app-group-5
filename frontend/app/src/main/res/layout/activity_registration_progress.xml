<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#022F77"
    tools:context=".RegistrationProgressActivity">

    <!-- Top Dark Navy Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:background="#022F77"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/registration_progress_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toTopOf="@id/btnBack"
            app:layout_constraintBottom_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Curved Light Content Sheet Container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_curved_light_sheet"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Overall Progress Card -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardProgressSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvProgressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85%"
                    android:textColor="#E51937"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvProgressLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Registration Status"
                    android:textColor="#022F77"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    app:layout_constraintTop_toTopOf="@id/tvProgressPercent"
                    app:layout_constraintStart_toEndOf="@id/tvProgressPercent" />

                <TextView
                    android:id="@+id/tvProgressSublabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="3 of 4 Steps Completed"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    app:layout_constraintTop_toBottomOf="@id/tvProgressLabel"
                    app:layout_constraintStart_toEndOf="@id/tvProgressPercent" />

                <View
                    android:id="@+id/trackBar"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_registration_track"
                    app:layout_constraintTop_toBottomOf="@id/tvProgressPercent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:id="@+id/fillBar"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_registration_fill"
                    app:layout_constraintTop_toTopOf="@id/trackBar"
                    app:layout_constraintBottom_toBottomOf="@id/trackBar"
                    app:layout_constraintStart_toStartOf="@id/trackBar"
                    app:layout_constraintWidth_percent="0.85" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Stepper Timeline Section Header -->
            <TextView
                android:id="@+id/tvTimelineHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Registration Steps"
                android:textColor="#022F77"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/cardProgressSummary"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Timeline Steps Container -->
            <LinearLayout
                android:id="@+id/containerSteps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tvTimelineHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Step 1: Fee Clearance -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_chip_green"
                        android:padding="6dp"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 1: Fee Clearance"
                            android:textColor="#022F77"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Cleared by Finance Department · 100% Paid"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 2: Course & Module Approval -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_chip_green"
                        android:padding="6dp"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 2: Module Selection"
                            android:textColor="#022F77"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="5/6 Modules Approved by Head of Department"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 3: Redeem Claim Code Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:elevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_icon_chip_amber"
                            android:padding="6dp"
                            android:src="@drawable/ic_notebook"
                            app:tint="#FFFFFF"
                            android:contentDescription="@null" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="Step 3: Redeem Lecturer Claim Code"
                            android:textColor="#022F77"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="If your lecturer provided a registration claim code, enter it below to automatically redeem your lab slot."
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                    <!-- Input + Redeem Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etClaimCodeInput"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_input_field"
                            android:fontFamily="@font/poppins"
                            android:hint="e.g. ICT361-LAB01"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnRedeemClaimCode"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_pill_button_red"
                            app:backgroundTint="@null"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="REDEEM"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Step 4: Lab Group Allocation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:background="@drawable/bg_button_rounded"
                    android:elevation="2dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_icon_chip_green"
                        android:padding="6dp"
                        android:src="@drawable/ic_check"
                        app:tint="#FFFFFF"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Step 4: Lab Group Allocation"
                            android:textColor="#022F77"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Allocated to Group G01 · Computer Lab 2"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
