<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_page_bg"
    tools:context=".MyGroupActivity">

    <!-- Top app bar -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cc_surface"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/cc_text_primary" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/CcAppBarTitle"
            android:layout_marginStart="4dp"
            android:text="@string/my_group_title" />
    </LinearLayout>

    <View
        android:id="@+id/appBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cc_divider_strong"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/appBarDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/skeletonDetail"
                layout="@layout/skeleton_detail" />

            <LinearLayout
                android:id="@+id/groupContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="invisible">

                <!-- Navy hero card -->
                <LinearLayout
                    android:id="@+id/cardGroupBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/cc_card_hero"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvGroupName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Lab Group G01"
                            android:textColor="@color/white"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:id="@+id/tvMembersPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/cc_badge_light"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="14/15 members"
                            android:textColor="@color/cc_navy"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCourseLecturer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="ICT 361 · Software Engineering · Lecturer: Dr. Mulenga"
                        android:textColor="@color/cc_on_navy_muted"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressGroupOccupancy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:trackThickness="6dp"
                        app:trackCornerRadius="3dp"
                        app:indicatorColor="@color/cc_light_blue"
                        app:trackColor="#33FFFFFF"
                        android:max="15"
                        android:progress="14" />
                </LinearLayout>

                <!-- Venue & Slot -->
                <TextView
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="Venue &amp; Slot" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="6dp">

                    <LinearLayout style="@style/CcIconRow">
                        <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_location_on" android:contentDescription="@null" />
                        <TextView style="@style/CcIconRowText" android:text="Computer Lab 2 (Main Campus)" />
                    </LinearLayout>
                    <LinearLayout style="@style/CcIconRow">
                        <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_computer" android:contentDescription="@null" />
                        <TextView style="@style/CcIconRowText" android:text="Assigned Workstation: PC-14" />
                    </LinearLayout>
                    <LinearLayout style="@style/CcIconRow">
                        <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_schedule" android:contentDescription="@null" />
                        <TextView style="@style/CcIconRowText" android:text="Wednesdays 10:00 AM – 12:00 PM" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Group members -->
                <TextView
                    android:id="@+id/tvMembersHeader"
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="@string/group_members" />

                <LinearLayout
                    android:id="@+id/containerMembers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <!-- Lecturer in charge -->
                <TextView
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="12dp"
                    android:text="@string/lecturer_in_charge" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_card_bordered"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/cc_avatar_navy"
                        android:gravity="center"
                        android:text="DM"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dr. Mulenga"
                            android:textColor="@color/cc_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lecturer in charge"
                            android:textColor="@color/cc_text_muted"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnLecturerMail"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/cc_iconchip_blue"
                        android:padding="10dp"
                        android:src="@drawable/ic_ms_mail"
                        app:tint="@color/cc_accent_blue"
                        android:contentDescription="Email lecturer" />
                </LinearLayout>

                <!-- Request group change -->
                <Button
                    android:id="@+id/btnRequestChange"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/cc_btn_outline"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_ms_swap_horiz"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/cc_navy"
                    android:gravity="center"
                    android:text="Request group change"
                    android:textAllCaps="false"
                    android:textColor="@color/cc_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/cc_bottom_nav_student"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
