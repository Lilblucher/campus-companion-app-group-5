<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".EditProfileActivity"
    android:fitsSystemWindows="true">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_ms_close"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Edit profile"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <ImageButton
            android:id="@+id/btnBell"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_ms_notifications"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Curved sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_curved_light_sheet">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- ===== Photo section ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:layout_marginBottom="8dp">

                    <!-- Avatar + camera overlay -->
                    <FrameLayout
                        android:layout_width="104dp"
                        android:layout_height="104dp">

                        <!-- Circular avatar (initials) -->
                        <TextView
                            android:id="@+id/tvAvatarInitials"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:background="@drawable/cc_avatar_crimson"
                            android:gravity="center"
                            android:text="CM"
                            android:textColor="@android:color/white"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <!-- Circular avatar (photo, shown when a picture is set) -->
                        <ImageView
                            android:id="@+id/ivAvatarPhoto"
                            android:layout_width="104dp"
                            android:layout_height="104dp"
                            android:background="@drawable/cc_avatar_crimson"
                            android:clipToOutline="true"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="Profile photo" />

                        <!-- Camera button -->
                        <ImageButton
                            android:id="@+id/btnCamera"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="@drawable/cc_camera_circle"
                            android:src="@drawable/ic_ms_photo_camera"
                            android:padding="8dp"
                            app:tint="@android:color/white"
                            android:contentDescription="Change photo" />
                    </FrameLayout>

                    <!-- Photo action buttons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnChoosePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/cc_btn_outline_navy"
                            app:backgroundTint="@null"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            android:text="Choose photo"
                            android:textAllCaps="false"
                            android:textColor="@color/cc_navy"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />

                        <Button
                            android:id="@+id/btnRemovePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Remove"
                            android:textAllCaps="false"
                            android:textColor="@color/cc_crimson"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/poppins" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Student Name ===== -->
                <TextView
                    style="@style/CcFieldLabel"
                    android:layout_marginTop="20dp"
                    android:text="Student Name" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CcInput"
                    android:id="@+id/tilName">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/CcInputEdit"
                        android:id="@+id/etName"
                        android:hint="Full name"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- ===== Student Number ===== -->
                <TextView
                    style="@style/CcFieldLabel"
                    android:text="Student Number" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/CcInput"
                    android:id="@+id/tilNumber">

                    <com.google.android.material.textfield.TextInputEditText
                        style="@style/CcInputEdit"
                        android:id="@+id/etNumber"
                        android:hint="e.g. 210482910"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:text="Used to sign in and to tell you apart from students with the same name."
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />

                <!-- ===== Programme segmented control ===== -->
                <TextView
                    style="@style/CcFieldLabel"
                    android:text="Programme" />

                <LinearLayout
                    android:id="@+id/segmentProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/segCS"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:background="@drawable/cc_segment_selected"
                        android:text="CS"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/segIT"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:gravity="center"
                        android:background="@drawable/cc_segment_unselected"
                        android:text="IT"
                        android:textColor="@color/cc_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/segDS"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:background="@drawable/cc_segment_unselected"
                        android:text="DS"
                        android:textColor="@color/cc_text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- ===== Year of Study (locked) ===== -->
                <TextView
                    style="@style/CcFieldLabel"
                    android:text="Year of Study" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/cc_locked_field"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_ms_lock"
                        app:tint="@color/cc_text_muted"
                        android:contentDescription="@null" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Year 3"
                        android:textColor="@color/cc_text_secondary"
                        android:textSize="15sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginStart="4dp"
                    android:text="Set by the Registrar each academic year. Contact Academic Office if it's wrong."
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />

                <!-- ===== Save changes button ===== -->
                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/cc_btn_navy"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_ms_save"
                    android:drawablePadding="10dp"
                    android:drawableTint="@android:color/white"
                    android:gravity="center"
                    android:text="Save changes"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</FrameLayout>
