<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".RegisterActivity">

    <!-- Top White Header Section -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="#022F77" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Create Your\nAccount"
            android:textColor="#022F77"
            android:textSize="26sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <!-- Deep Navy Curved Sheet Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_curved_navy_sheet"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <!-- Full Student Name -->
            <TextView
                android:id="@+id/lblStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/student_name"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:errorTextColor="#E51937"
                app:layout_constraintTop_toBottomOf="@id/lblStudentName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="textPersonName|textCapWords"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="Chileshe Mulenga"
                    android:paddingBottom="6dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Student ID Number -->
            <TextView
                android:id="@+id/lblStudentId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/student_number"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tilStudentName"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:errorTextColor="#E51937"
                app:layout_constraintTop_toBottomOf="@id/lblStudentId"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentId"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="number"
                    android:maxLength="9"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="210482910"
                    android:paddingBottom="6dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Programme Dropdown -->
            <TextView
                android:id="@+id/lblProgramme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/programme"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tilStudentId"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProgramme"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:errorTextColor="#E51937"
                app:endIconTint="#CBD5E1"
                app:layout_constraintTop_toBottomOf="@id/lblProgramme"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actProgramme"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="none"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="Select Programme"
                    android:paddingBottom="6dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                android:id="@+id/lblPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/password"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tilProgramme"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:endIconMode="password_toggle"
                app:endIconTint="#94A3B8"
                app:errorTextColor="#E51937"
                app:layout_constraintTop_toBottomOf="@id/lblPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="••••••••"
                    android:paddingBottom="6dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password strength row -->
            <LinearLayout
                android:id="@+id/strengthRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@id/tilPassword"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/tvPasswordStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:textColor="#0457DD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:visibility="invisible"
                    tools:text="@string/password_strength_weak" />

                <View
                    android:id="@+id/strengthDot1"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/shape_loading_dot" />

                <View
                    android:id="@+id/strengthDot2"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/shape_loading_dot" />

                <View
                    android:id="@+id/strengthDot3"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/shape_loading_dot" />

            </LinearLayout>

            <!-- Confirm Password -->
            <TextView
                android:id="@+id/lblConfirmPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/confirm_password"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/strengthRow"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:errorEnabled="true"
                app:endIconMode="password_toggle"
                app:endIconTint="#94A3B8"
                app:errorTextColor="#E51937"
                app:layout_constraintTop_toBottomOf="@id/lblConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="textPassword"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="••••••••"
                    android:paddingBottom="6dp"
                    android:textSize="14sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPasswordMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:visibility="invisible"
                app:layout_constraintTop_toBottomOf="@id/tilConfirmPassword"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="@string/password_matched" />

            <!-- Claim code (optional) -->
            <TextView
                android:id="@+id/lblClaimCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/claim_code_label"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tvPasswordMatch"
                app:layout_constraintStart_toStartOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilClaimCode"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:boxBackgroundMode="none"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/lblClaimCode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClaimCode"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_input_underline"
                    android:fontFamily="@font/poppins"
                    android:inputType="textCapCharacters"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#64748B"
                    android:hint="Optional"
                    android:paddingBottom="6dp"
                    android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Sign Up Button -->
            <Button
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_pill_button_red"
                app:backgroundTint="@null"
                android:text="SIGN UP"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:elevation="4dp"
                app:layout_constraintTop_toBottomOf="@id/tilClaimCode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Already have an account link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/btnRegisterSubmit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#CBD5E1"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:text="Sign In"
                    android:textColor="#E51937"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
