<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#022F77"
    tools:context=".LecturerDashboardActivity">

    <!-- Top Dark Navy Header Section -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:background="#022F77"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Search bar + avatar -->
        <LinearLayout
            android:id="@+id/searchBar"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:layout_constraintWidth_max="220dp"
            app:layout_constraintHorizontal_bias="0.0"
            android:background="@drawable/bg_search_bar"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintEnd_toStartOf="@id/avatarContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="#64748B" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/lecturer_search_hint"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/avatarContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="12dp"
            android:elevation="3dp"
            app:layout_constraintTop_toTopOf="@id/searchBar"
            app:layout_constraintBottom_toBottomOf="@id/searchBar"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_avatar_circle"
                android:padding="8dp"
                android:src="@drawable/ic_nav_profile"
                app:tint="#022F77"
                android:contentDescription="@string/nav_profile" />

            <View
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_status_dot" />

        </FrameLayout>

        <!-- Welcome block -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/searchBar"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="Welcome back, Dr. Mulenga" />

        <TextView
            android:id="@+id/tvDepartment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/lecturer_role"
            android:textColor="#CBD5E1"
            android:textSize="13sp"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/tvWelcome"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SwipeToRefresh & Curved Light Content Sheet Container -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_curved_light_sheet"
            android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp">

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:id="@+id/chipScrollView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_selected"
                        android:text="Overview"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="My Courses"
                        android:textColor="#022F77"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Lab Groups"
                        android:textColor="#022F77"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:text="Broadcasts"
                        android:textColor="#022F77"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- 2x2 Quick Access Grid -->
            <!-- Tile 1: Generate Claim Code -->
            <LinearLayout
                android:id="@+id/tileGenerateClaimCode"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/chipScrollView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tileMyCourses">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_chip_amber"
                    android:padding="6dp"
                    android:src="@drawable/ic_notebook"
                    app:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/generate_claim_code"
                    android:textColor="#022F77"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/generate_claim_code_desc"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <!-- Tile 2: My Courses -->
            <LinearLayout
                android:id="@+id/tileMyCourses"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/tileGenerateClaimCode"
                app:layout_constraintStart_toEndOf="@id/tileGenerateClaimCode"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_chip_green"
                    android:padding="6dp"
                    android:src="@drawable/ic_school"
                    app:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/my_courses"
                    android:textColor="#022F77"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/my_courses_desc"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <!-- Tile 3: Lab Groups -->
            <LinearLayout
                android:id="@+id/tileLabGroups"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toBottomOf="@id/tileGenerateClaimCode"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tilePostAnnouncement">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_chip_purple"
                    android:padding="6dp"
                    android:src="@drawable/ic_users"
                    app:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/lab_groups_tile"
                    android:textColor="#022F77"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lab_groups_desc"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <!-- Tile 4: Post Announcement -->
            <LinearLayout
                android:id="@+id/tilePostAnnouncement"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="6dp"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintTop_toTopOf="@id/tileLabGroups"
                app:layout_constraintStart_toEndOf="@id/tileLabGroups"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_icon_chip_amber"
                    android:padding="6dp"
                    android:src="@drawable/ic_nav_bell"
                    app:tint="#FFFFFF"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/post_announcement"
                    android:textColor="#022F77"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/post_announcement_desc"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins" />

            </LinearLayout>

            <!-- Upcoming Lecture Card Section -->
            <TextView
                android:id="@+id/tvUpcomingLectureHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/upcoming_lecture"
                android:textColor="#022F77"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                app:layout_constraintTop_toBottomOf="@id/tileLabGroups"
                app:layout_constraintStart_toStartOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardUpcomingLecture"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="16dp"
                android:background="@drawable/bg_button_rounded"
                android:elevation="3dp"
                app:layout_constraintTop_toBottomOf="@id/tvUpcomingLectureHeader"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivLectureIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_next_class"
                    android:padding="8dp"
                    android:src="@drawable/ic_calendar_event"
                    app:tint="#0457DD"
                    android:contentDescription="@null"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvLectureTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="#022F77"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    tools:text="ICT 361 - Software Engineering"
                    app:layout_constraintTop_toTopOf="@id/ivLectureIcon"
                    app:layout_constraintStart_toEndOf="@id/ivLectureIcon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvLectureTimeLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins"
                    tools:text="10:00 AM – 12:00 PM · Computer Lab 2"
                    app:layout_constraintTop_toBottomOf="@id/tvLectureTitle"
                    app:layout_constraintStart_toEndOf="@id/ivLectureIcon"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvLectureGroupInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#E51937"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    tools:text="Lab Group G01 · 32 Students Enrolled"
                    app:layout_constraintTop_toBottomOf="@id/ivLectureIcon"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Fixed Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navDashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/nav_icon_tint"
                android:src="@drawable/ic_nav_home"
                android:contentDescription="@string/nav_dashboard" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_dashboard"
                android:textColor="@color/nav_icon_tint"
                android:textSize="10sp"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/nav_icon_tint"
                android:src="@drawable/ic_nav_group"
                android:contentDescription="@string/nav_group" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_group"
                android:textColor="@color/nav_icon_tint"
                android:textSize="10sp"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navAlerts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                app:tint="@color/nav_icon_tint"
                android:src="@drawable/ic_nav_bell"
                android:contentDescription="@string/nav_alerts" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/nav_alerts"
                android:textColor="@color/nav_icon_tint"
                android:textSize="10sp"
                android:fontFamily="@font/poppins" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

