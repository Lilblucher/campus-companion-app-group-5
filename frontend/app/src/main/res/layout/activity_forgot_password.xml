<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".ForgotPasswordActivity"
    android:fitsSystemWindows="true">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset Your\nPassword"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:fontFamily="@font/poppins" />
    </LinearLayout>

    <!-- White sheet -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/cc_sheet_top"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- 2-step indicator -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/stepEmail"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:background="@drawable/cc_dot_navy"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Email"
                    android:textColor="@color/cc_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@color/cc_divider_strong" />

                <TextView
                    android:id="@+id/stepCode"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:background="@drawable/cc_skel_circle"
                    android:text="2"
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Code"
                    android:textColor="@color/cc_text_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Email -->
            <TextView style="@style/CcFieldLabel" android:text="Email address" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilEmail"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_mail">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etEmail"
                    style="@style/CcInputEdit"
                    android:inputType="textEmailAddress"
                    android:hint="you@mu.ac.zm" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnGetCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/cc_btn_navy"
                app:backgroundTint="@null"
                android:text="Get reset code"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:elevation="2dp" />

            <!-- Step 2 -->
            <TextView
                android:id="@+id/tvCodeSentMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/cc_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins"
                android:visibility="gone"
                tools:text="We sent a 6-digit code to group5@gmail.com"
                tools:visibility="visible" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilResetCode"
                style="@style/CcInput"
                android:visibility="gone"
                tools:visibility="visible">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etResetCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:fontFamily="@font/poppins"
                    android:inputType="number"
                    android:maxLength="6"
                    android:gravity="center"
                    android:letterSpacing="0.4"
                    android:textColor="@color/cc_text_primary"
                    android:textColorHint="@color/cc_text_muted"
                    android:hint="------"
                    android:textSize="18sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/btnResendCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:text="@string/resend_code"
                android:textColor="@color/cc_accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNewPassword"
                style="@style/CcInput"
                android:visibility="gone"
                app:startIconDrawable="@drawable/ic_ms_lock"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cc_text_muted"
                tools:visibility="visible">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNewPassword"
                    style="@style/CcInputEdit"
                    android:inputType="textPassword"
                    android:hint="New password" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/strengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View android:id="@+id/strengthDot1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/cc_skel_line" />
                <View android:id="@+id/strengthDot2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/cc_skel_line" />
                <View android:id="@+id/strengthDot3" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/cc_skel_line" />
                <TextView
                    android:id="@+id/tvPasswordStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cc_accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:visibility="invisible"
                    tools:text="Strong" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmNewPassword"
                style="@style/CcInput"
                android:visibility="gone"
                app:startIconDrawable="@drawable/ic_ms_lock_reset"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cc_text_muted"
                tools:visibility="visible">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmNewPassword"
                    style="@style/CcInputEdit"
                    android:inputType="textPassword"
                    android:hint="Confirm new password" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPasswordMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:visibility="invisible"
                tools:text="Password Matched" />

            <Button
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/cc_btn_crimson"
                app:backgroundTint="@null"
                android:text="@string/reset_password_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:elevation="2dp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
