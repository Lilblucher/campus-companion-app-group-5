<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_page_bg"
    tools:context=".SettingsActivity"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cc_surface"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/cc_text_primary" />

        <TextView
            style="@style/CcAppBarTitle"
            android:layout_marginStart="4dp"
            android:text="@string/settings_title" />
    </LinearLayout>

    <View
        android:id="@+id/appBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cc_divider_strong"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/appBarDivider"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Account & Security -->
            <TextView style="@style/CcSectionTitle" android:text="@string/account_settings" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/cc_card_bordered"
                android:padding="6dp">

                <!-- Biometric -->
                <LinearLayout style="@style/CcSwitchRow">
                    <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_fingerprint" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcSwitchText">
                        <TextView style="@style/CcSwitchTitle" android:text="@string/biometric_login" />
                        <TextView style="@style/CcSwitchSub" android:text="Use fingerprint or face unlock to sign in" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchBiometrics" style="@style/CcSwitch" />
                </LinearLayout>

                <View style="@style/CcRowDivider" />

                <!-- Push notifications -->
                <LinearLayout style="@style/CcSwitchRow">
                    <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_notifications_active" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcSwitchText">
                        <TextView style="@style/CcSwitchTitle" android:text="@string/notifications_pref" />
                        <TextView style="@style/CcSwitchSub" android:text="Receive class updates and lecturer alerts" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchNotifications" style="@style/CcSwitch" />
                </LinearLayout>

                <View style="@style/CcRowDivider" />

                <!-- Dark theme -->
                <LinearLayout style="@style/CcSwitchRow">
                    <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_dark_mode" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcSwitchText">
                        <TextView style="@style/CcSwitchTitle" android:text="@string/dark_mode" />
                        <TextView style="@style/CcSwitchSub" android:text="Follow a darker colour scheme" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDarkTheme" style="@style/CcSwitch" />
                </LinearLayout>
            </LinearLayout>

            <!-- Offline Data Sync -->
            <TextView style="@style/CcSectionTitle" android:layout_marginTop="20dp" android:text="@string/offline_sync" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/cc_card_bordered"
                android:padding="6dp">

                <LinearLayout style="@style/CcSwitchRow">
                    <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_cloud_sync" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcSwitchText">
                        <TextView style="@style/CcSwitchTitle" android:text="@string/offline_sync" />
                        <TextView style="@style/CcSwitchSub" android:text="Cache timetables and lab details for offline view" />
                    </LinearLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchOfflineSync" style="@style/CcSwitch" />
                </LinearLayout>

                <View style="@style/CcRowDivider" />

                <LinearLayout
                    android:id="@+id/rowSyncNow"
                    style="@style/CcSwitchRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">
                    <ImageView style="@style/CcSwitchIcon" android:src="@drawable/ic_ms_sync" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcSwitchText">
                        <TextView style="@style/CcSwitchTitle" android:text="Sync now" />
                        <TextView android:id="@+id/tvLastSync" style="@style/CcSwitchSub" android:text="Pull the latest data from the server" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_ms_chevron_right"
                        app:tint="@color/cc_text_muted"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <!-- About -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/cc_card_bordered"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app"
                    android:textColor="@color/cc_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_version"
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        layout="@layout/cc_bottom_nav_student"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
