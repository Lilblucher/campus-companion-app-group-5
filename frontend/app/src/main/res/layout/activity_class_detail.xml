<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_page_bg"
    tools:context=".ClassDetailActivity">

    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/cc_surface"
        android:paddingStart="4dp"
        android:paddingEnd="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/cc_text_primary" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            style="@style/CcAppBarTitle"
            android:layout_marginStart="4dp"
            android:text="@string/class_details_title" />
    </LinearLayout>

    <View
        android:id="@+id/appBarDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cc_divider_strong"
        app:layout_constraintTop_toBottomOf="@id/topHeaderSection" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/appBarDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Navy hero -->
            <LinearLayout
                android:id="@+id/cardCourseHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/cc_card_hero"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvCourseBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cc_badge_crimson"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:text="ICT 361"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/tvCourseTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Software Engineering"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_ms_schedule"
                        app:tint="@color/cc_on_navy_muted"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvScheduleTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Wednesdays 10:00 AM – 12:00 PM"
                        android:textColor="@color/cc_on_navy_muted"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>
            </LinearLayout>

            <!-- Venue -->
            <TextView style="@style/CcSectionTitle" android:layout_marginTop="20dp" android:text="Venue Allocation" />

            <LinearLayout
                android:id="@+id/cardVenue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/cc_card_bordered"
                android:padding="6dp">

                <LinearLayout style="@style/CcIconRow">
                    <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_location_on" android:contentDescription="@null" />
                    <TextView android:id="@+id/tvRoomName" style="@style/CcIconRowText" android:text="Computer Lab 2 (Main Campus)" />
                </LinearLayout>
                <LinearLayout style="@style/CcIconRow">
                    <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_computer" android:contentDescription="@null" />
                    <TextView android:id="@+id/tvWorkstationNo" style="@style/CcIconRowText" android:text="Assigned Workstation: PC-14 (Row 3)" />
                </LinearLayout>
            </LinearLayout>

            <!-- Lecturer -->
            <TextView style="@style/CcSectionTitle" android:layout_marginTop="20dp" android:text="Lecturer Info" />

            <LinearLayout
                android:id="@+id/cardLecturer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:background="@drawable/cc_card_bordered"
                android:padding="6dp">

                <LinearLayout style="@style/CcIconRow">
                    <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_co_present" android:contentDescription="@null" />
                    <TextView android:id="@+id/tvLecturerName" style="@style/CcIconRowText" android:text="Dr. Mulenga" />
                </LinearLayout>
                <LinearLayout style="@style/CcIconRow">
                    <ImageView style="@style/CcIconRowIcon" android:src="@drawable/ic_ms_event_available" android:contentDescription="@null" />
                    <TextView android:id="@+id/tvLecturerHours" style="@style/CcIconRowText" android:text="Office Hours: Tue &amp; Thu 14:00 – 16:00 (Office B-12)" />
                </LinearLayout>
            </LinearLayout>

            <!-- Course materials -->
            <TextView style="@style/CcSectionTitle" android:layout_marginTop="20dp" android:text="Course Materials" />

            <LinearLayout
                android:id="@+id/btnCourseMaterials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/cc_card_bordered"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_ms_picture_as_pdf"
                    app:tint="@color/cc_crimson"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View course materials"
                        android:textColor="@color/cc_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="4 PDFs available for download"
                        android:textColor="@color/cc_text_muted"
                        android:textSize="12sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_ms_chevron_right"
                    app:tint="@color/cc_text_muted"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- Download -->
            <Button
                android:id="@+id/btnDownloadManual"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/cc_btn_navy"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_download"
                android:drawablePadding="8dp"
                android:drawableTint="@color/white"
                android:gravity="center"
                android:text="Download lab manual"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
