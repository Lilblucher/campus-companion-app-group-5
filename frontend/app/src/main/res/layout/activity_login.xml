<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".LoginActivity"
    android:fitsSystemWindows="true">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/white"
            android:contentDescription="@string/content_desc_back" />

        <TextView
            android:id="@+id/tvHeaderGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Hello\nWelcome Back!"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:fontFamily="@font/poppins" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sign_in_to_continue"
            android:textColor="@color/cc_on_navy_muted"
            android:textSize="13sp"
            android:fontFamily="@font/poppins" />

    </LinearLayout>

    <!-- White sheet (28dp top corners) -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/cc_sheet_top"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="32dp">

            <!-- Role segmented control -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:background="@drawable/cc_segment_track"
                android:padding="4dp">

                <LinearLayout
                    android:id="@+id/roleStudent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/cc_segment_thumb"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/icRoleStudent"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_ms_school"
                        app:tint="@color/cc_navy"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvRoleStudent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:textColor="@color/cc_navy"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/roleLecturer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/icRoleLecturer"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:src="@drawable/ic_ms_co_present"
                        app:tint="@color/cc_text_muted"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvRoleLecturer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lecturer"
                        android:textColor="@color/cc_text_muted"
                        android:textSize="14sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>
            </LinearLayout>

            <!-- Student Number or Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Student Number or Email"
                android:textColor="@color/cc_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentId"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/cc_accent_blue"
                app:boxStrokeWidth="1dp"
                app:startIconDrawable="@drawable/ic_ms_badge"
                app:startIconTint="@color/cc_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentId"
                    style="@style/CcInputEdit"
                    android:inputType="text"
                    android:hint="e.g. 210482910" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/password"
                android:textColor="@color/cc_text_secondary"
                android:textSize="13sp"
                android:fontFamily="@font/poppins" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:hintEnabled="false"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="@color/cc_accent_blue"
                app:boxStrokeWidth="1dp"
                app:startIconDrawable="@drawable/ic_ms_lock"
                app:startIconTint="@color/cc_text_muted"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cc_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/CcInputEdit"
                    android:inputType="textPassword"
                    android:hint="Enter password" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Error row -->
            <LinearLayout
                android:id="@+id/errorRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ic_ms_error"
                    app:tint="@color/cc_crimson_dark"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_wrong_credentials"
                    android:textColor="@color/cc_crimson_dark"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Forgot password -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:text="@string/forgot_password"
                android:textColor="@color/cc_accent_blue"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <!-- Sign in -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/cc_btn_navy"
                app:backgroundTint="@null"
                android:text="@string/sign_in"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:elevation="2dp" />

            <!-- Or continue with -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/cc_divider_strong" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:text="@string/or_continue_with"
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/cc_divider_strong" />
            </LinearLayout>

            <!-- Social buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGoogle"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/cc_btn_outline"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_google_placeholder"
                    android:drawablePadding="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Google"
                    android:textAllCaps="false"
                    android:textColor="@color/cc_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins" />

                <Button
                    android:id="@+id/btnFacebook"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/cc_btn_outline"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_facebook_placeholder"
                    android:drawablePadding="8dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:text="Facebook"
                    android:textAllCaps="false"
                    android:textColor="@color/cc_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Sign up link -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? "
                    android:textColor="@color/cc_text_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/btnRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:text="Sign Up"
                    android:textColor="@color/cc_crimson"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
