<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".MyCoursesActivity">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/topHeaderSection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/courses_title"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins" />

        <ImageButton
            android:id="@+id/btnBell"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_ms_notifications"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Curved sheet -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="64dp"
        android:background="@drawable/bg_curved_light_sheet">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <!-- Hero card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/cc_card_hero"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Computer Science"
                        android:textColor="@android:color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Year 3 · Semester 1 · 3 courses enrolled"
                        android:textColor="@color/cc_on_navy_muted"
                        android:textSize="13sp"
                        android:fontFamily="@font/poppins" />
                </LinearLayout>

                <!-- Course cards -->
                <TextView
                    style="@style/CcSectionTitle"
                    android:layout_marginTop="20dp"
                    android:text="Enrolled courses" />

                <LinearLayout android:id="@+id/cardCourse1" style="@style/CcCourseCard" android:layout_marginTop="10dp">
                    <ImageView style="@style/CcCourseIcon" android:background="@drawable/cc_iconchip_blue" android:src="@drawable/ic_ms_code" app:tint="@color/cc_accent_blue" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcCourseText">
                        <TextView style="@style/CcCourseTitle" android:text="ICT 361 · Software Engineering" />
                        <TextView style="@style/CcCourseMeta" android:text="Dr. Mulenga · 3 Credits · Computer Lab 2" />
                        <TextView style="@style/CcCourseMeta" android:text="4 PDFs available" android:textColor="@color/cc_navy" />
                    </LinearLayout>
                    <ImageView style="@style/CcCourseChevron" android:src="@drawable/ic_ms_chevron_right" android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cardCourse2" style="@style/CcCourseCard">
                    <ImageView style="@style/CcCourseIcon" android:background="@drawable/cc_iconchip_amber" android:src="@drawable/ic_ms_account_tree" app:tint="@color/cc_warning_strong" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcCourseText">
                        <TextView style="@style/CcCourseTitle" android:text="CSC 311 · Algorithms &amp; Data Structures" />
                        <TextView style="@style/CcCourseMeta" android:text="Prof. Banda · 4 Credits · Lecture Hall 1" />
                        <TextView style="@style/CcCourseMeta" android:text="4 PDFs available" android:textColor="@color/cc_navy" />
                    </LinearLayout>
                    <ImageView style="@style/CcCourseChevron" android:src="@drawable/ic_ms_chevron_right" android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cardCourse3" style="@style/CcCourseCard">
                    <ImageView style="@style/CcCourseIcon" android:background="@drawable/cc_iconchip_green" android:src="@drawable/ic_ms_query_stats" app:tint="@color/cc_success" android:contentDescription="@null" />
                    <LinearLayout style="@style/CcCourseText">
                        <TextView style="@style/CcCourseTitle" android:text="CSC 312 · Computer Networks" />
                        <TextView style="@style/CcCourseMeta" android:text="Dr. Phiri · 3 Credits · Lab 3" />
                        <TextView style="@style/CcCourseMeta" android:text="4 PDFs available" android:textColor="@color/cc_navy" />
                    </LinearLayout>
                    <ImageView style="@style/CcCourseChevron" android:src="@drawable/ic_ms_chevron_right" android:contentDescription="@null" />
                </LinearLayout>

                <!-- View materials button -->
                <Button
                    android:id="@+id/btnViewMaterials"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/cc_btn_outline_navy"
                    app:backgroundTint="@null"
                    android:drawableStart="@drawable/ic_ms_picture_as_pdf"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/cc_navy"
                    android:gravity="center"
                    android:text="View all course materials"
                    android:textAllCaps="false"
                    android:textColor="@color/cc_navy"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins" />

                <!-- Footer note -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Course materials are updated by lecturers. Check regularly for new uploads."
                    android:textColor="@color/cc_text_muted"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Bottom nav -->
    <include
        layout="@layout/cc_bottom_nav_student"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
