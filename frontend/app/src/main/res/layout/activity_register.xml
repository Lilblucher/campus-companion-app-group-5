<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_navy"
    tools:context=".RegisterActivity">

    <!-- Navy header -->
    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/content_desc_back"
            android:src="@drawable/ic_ms_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Create Your\nAccount"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.1"
            android:fontFamily="@font/poppins" />
    </LinearLayout>

    <!-- White sheet -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/cc_sheet_top"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/headerSection"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- Student Name -->
            <TextView style="@style/CcFieldLabel" android:text="@string/student_name" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentName"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_person">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentName"
                    style="@style/CcInputEdit"
                    android:inputType="textPersonName|textCapWords"
                    android:hint="Full name" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Same-name info banner (hidden by default) -->
            <LinearLayout
                android:id="@+id/sameNameBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/cc_banner_info"
                android:padding="12dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_ms_groups"
                    app:tint="#022F77"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/same_name_banner"
                    android:textColor="#022F77"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Student Number -->
            <TextView style="@style/CcFieldLabel" android:text="@string/student_number" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilStudentId"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_badge">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStudentId"
                    style="@style/CcInputEdit"
                    android:inputType="number"
                    android:maxLength="9"
                    android:hint="9 digits" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Phone + Email (2-col grid) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
                    <TextView style="@style/CcFieldLabel" android:text="@string/phone_number" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPhone"
                        style="@style/CcInput"
                        app:startIconDrawable="@drawable/ic_ms_call">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPhone"
                            style="@style/CcInputEdit"
                            android:inputType="phone"
                            android:hint="+260" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                    <TextView style="@style/CcFieldLabel" android:text="@string/email" />
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilEmail"
                        style="@style/CcInput"
                        app:startIconDrawable="@drawable/ic_ms_mail">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmail"
                            style="@style/CcInputEdit"
                            android:inputType="textEmailAddress"
                            android:hint="you@mu.ac.zm" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Programme -->
            <TextView style="@style/CcFieldLabel" android:text="@string/programme" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProgramme"
                style="@style/CcInputDropdown"
                app:startIconDrawable="@drawable/ic_ms_school">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actProgramme"
                    style="@style/CcInputEdit"
                    android:inputType="none"
                    android:hint="Select Programme" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Year of Study -->
            <TextView style="@style/CcFieldLabel" android:text="@string/year_of_study_label" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilYearOfStudy"
                style="@style/CcInputDropdown"
                app:startIconDrawable="@drawable/ic_ms_calendar_today">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actYearOfStudy"
                    style="@style/CcInputEdit"
                    android:inputType="none"
                    android:hint="Select Year" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lab Group -->
            <TextView style="@style/CcFieldLabel" android:text="@string/lab_group_label" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilLabGroup"
                style="@style/CcInputDropdown"
                app:startIconDrawable="@drawable/ic_ms_groups">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actLabGroup"
                    style="@style/CcInputEdit"
                    android:inputType="none"
                    android:hint="Select Lab Group" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Claim code (optional) -->
            <TextView style="@style/CcFieldLabel" android:text="@string/claim_code_label" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilClaimCode"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_key">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etClaimCode"
                    style="@style/CcInputEdit"
                    android:inputType="textCapCharacters"
                    android:hint="e.g. MU-7F3K-01" />
            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/claim_code_helper"
                android:textColor="@color/cc_text_muted"
                android:textSize="12sp"
                android:fontFamily="@font/poppins" />

            <!-- Password -->
            <TextView style="@style/CcFieldLabel" android:text="@string/password" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPassword"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_lock"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cc_text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPassword"
                    style="@style/CcInputEdit"
                    android:inputType="textPassword"
                    android:hint="Create a password" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- 3-segment strength meter -->
            <LinearLayout
                android:id="@+id/strengthRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View android:id="@+id/strengthDot1" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/cc_skel_line" />
                <View android:id="@+id/strengthDot2" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:background="@drawable/cc_skel_line" />
                <View android:id="@+id/strengthDot3" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:layout_marginEnd="8dp" android:background="@drawable/cc_skel_line" />
                <TextView
                    android:id="@+id/tvPasswordStrength"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cc_accent_blue"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:visibility="invisible"
                    tools:text="Strong" />
            </LinearLayout>

            <!-- Confirm Password -->
            <TextView style="@style/CcFieldLabel" android:text="@string/confirm_password" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmPassword"
                style="@style/CcInput"
                app:startIconDrawable="@drawable/ic_ms_lock_reset"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/cc_text_muted">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmPassword"
                    style="@style/CcInputEdit"
                    android:inputType="textPassword"
                    android:hint="Re-enter password" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvPasswordMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:visibility="invisible"
                tools:text="Password Matched" />

            <!-- Sign up -->
            <Button
                android:id="@+id/btnRegisterSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/cc_btn_crimson"
                app:backgroundTint="@null"
                android:text="@string/sign_up"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins"
                android:elevation="2dp" />

            <!-- Save draft offline -->
            <Button
                android:id="@+id/btnSaveDraft"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/cc_btn_outline"
                app:backgroundTint="@null"
                android:drawableStart="@drawable/ic_ms_cloud_off"
                android:drawablePadding="8dp"
                android:drawableTint="@color/cc_text_secondary"
                android:gravity="center"
                android:text="Save draft offline"
                android:textAllCaps="false"
                android:textColor="@color/cc_text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins" />

            <!-- Footer -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="@color/cc_text_muted"
                    android:textSize="13sp"
                    android:fontFamily="@font/poppins" />

                <TextView
                    android:id="@+id/btnGoToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center_vertical"
                    android:text="Sign In"
                    android:textColor="@color/cc_crimson"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/poppins"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
