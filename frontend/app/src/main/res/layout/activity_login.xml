<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_light_blue"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <!-- Logo + app name -->
        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/app_icon_desc"
            android:src="@drawable/ic_app_logo"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/color_primary_dark"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/ivAppIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Student ID field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStudentId"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:hint="@string/student_number"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/color_border_blue"
            app:boxStrokeErrorColor="@color/color_error_red"
            app:errorEnabled="true"
            app:errorIconDrawable="@null"
            app:hintTextColor="@color/color_text_muted"
            app:layout_constraintTop_toBottomOf="@id/tvAppName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStudentId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:inputType="number"
                android:maxLength="9"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password field -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/password"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="@color/color_border_blue"
            app:boxStrokeErrorColor="@color/color_error_red"
            app:errorEnabled="true"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/color_text_muted"
            app:hintTextColor="@color/color_text_muted"
            app:layout_constraintTop_toBottomOf="@id/tilStudentId"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:inputType="textPassword"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/forgot_password"
            android:textColor="@color/color_text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintTop_toBottomOf="@id/tilPassword"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Login button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_login_gradient"
            android:text="@string/login"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvForgotPassword"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Divider row: "Or continue with" -->
        <View
            android:id="@+id/dividerStart"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="12dp"
            android:background="@color/color_text_muted"
            app:layout_constraintTop_toTopOf="@id/tvOrContinueWith"
            app:layout_constraintBottom_toBottomOf="@id/tvOrContinueWith"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvOrContinueWith" />

        <TextView
            android:id="@+id/tvOrContinueWith"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/or_continue_with"
            android:textColor="@color/color_text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/btnLogin"
            app:layout_constraintStart_toEndOf="@id/dividerStart"
            app:layout_constraintEnd_toStartOf="@id/dividerEnd" />

        <View
            android:id="@+id/dividerEnd"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="12dp"
            android:background="@color/color_text_muted"
            app:layout_constraintTop_toTopOf="@id/tvOrContinueWith"
            app:layout_constraintBottom_toBottomOf="@id/tvOrContinueWith"
            app:layout_constraintStart_toEndOf="@id/tvOrContinueWith"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Social login placeholders -->
        <LinearLayout
            android:id="@+id/socialLoginRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvOrContinueWith"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnFacebookLogin"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_social_circle"
                android:contentDescription="@string/content_desc_facebook_login"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_facebook_placeholder" />

            <ImageButton
                android:id="@+id/btnGoogleLogin"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_social_circle"
                android:contentDescription="@string/content_desc_google_login"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_google_placeholder" />

        </LinearLayout>

        <!-- Register -->
        <TextView
            android:id="@+id/tvNoAccount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dont_have_account"
            android:textColor="@color/color_text_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:layout_constraintTop_toBottomOf="@id/socialLoginRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnRegister"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/register"
            android:textAllCaps="false"
            android:textColor="@color/color_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins"
            app:cornerRadius="12dp"
            app:strokeColor="@color/color_primary_dark"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvNoAccount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
